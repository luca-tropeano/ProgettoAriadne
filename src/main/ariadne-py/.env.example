# Ariadne - Environment Variables
# Copy this file to .env and fill in your values

# --- DeepSeek AI ---
# AI is DISABLED by default. Set to true ONLY when you need it:
# it is used as a paid fallback when the direct PDF parser finds nothing.
DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MAX_TOKENS=2000

# --- Strapi (future) ---
# STRAPI_BASE_URL=http://localhost:1337
# STRAPI_API_TOKEN=

# --- SFTP (future) ---
# SFTP_HOST=
# SFTP_PORT=22
# SFTP_USER=
# SFTP_PASSWORD=
# SFTP_REMOTE_PATH=/uploads

# --- Database (future) ---
# DATABASE_URL=sqlite:///ariadne.db
